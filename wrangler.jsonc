{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pangol",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3c318f8f-854b-42fb-8b74-87914e38d9fa","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0004c5f11327466d9a844cd474e11876" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
